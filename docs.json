{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Tether.ai",
  "colors": {
    "primary": "#6E62F8",
    "light": "#6E62F8",
    "dark": "#6E62F8"
  },
  "background": {
    "color": {
      "dark": "#0B0B0B"
    }
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "guides/authentication",
              "guides/architecture"
            ]
          }
        ]
      },
      {
        "tab": "API guides",
        "groups": [
          {
            "group": "Core resources",
            "pages": [
              "api-guides/contacts",
              "api-guides/conversations",
              "api-guides/messages",
              "api-guides/applications"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "api-guides/organizations",
              "api-guides/users",
              "api-guides/groups",
              "api-guides/attachments",
              "api-guides/errors",
              "api-guides/sdks"
            ]
          },
          {
            "group": "Automation and AI",
            "pages": [
              "api-guides/automations",
              "api-guides/pipelines",
              "api-guides/ai",
              "api-guides/outreach"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/verification"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.yaml"
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Status",
        "href": "https://status.sendgrid.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Contact support",
      "href": "mailto:support@tetherai.ca"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "redirects": [
    {
      "source": "/authentication",
      "destination": "/guides/authentication"
    },
    {
      "source": "/contacts",
      "destination": "/api-guides/contacts"
    },
    {
      "source": "/conversations",
      "destination": "/api-guides/conversations"
    },
    {
      "source": "/messages",
      "destination": "/api-guides/messages"
    },
    {
      "source": "/organizations",
      "destination": "/api-guides/organizations"
    },
    {
      "source": "/users",
      "destination": "/api-guides/users"
    },
    {
      "source": "/automations",
      "destination": "/api-guides/automations"
    },
    {
      "source": "/pipelines",
      "destination": "/api-guides/pipelines"
    },
    {
      "source": "/applications",
      "destination": "/api-guides/applications"
    },
    {
      "source": "/ai",
      "destination": "/api-guides/ai"
    },
    {
      "source": "/outreach",
      "destination": "/api-guides/outreach"
    },
    {
      "source": "/groups",
      "destination": "/api-guides/groups"
    },
    {
      "source": "/attachments",
      "destination": "/api-guides/attachments"
    },
    {
      "source": "/errors",
      "destination": "/api-guides/errors"
    },
    {
      "source": "/sdks",
      "destination": "/api-guides/sdks"
    },
    {
      "source": "/webhooks",
      "destination": "/api-guides/outreach"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
